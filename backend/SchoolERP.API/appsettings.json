{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=school_erp;User=root;Password=123456;Port=3306;TreatTinyAsBoolean=true;"
  },
  "JwtSettings": {
    "Secret": "SuperSecretKeySchoolERPProjectDefault2026!@#$%^&*()_+UniqueKey",
    "Issuer": "SchoolERP",
    "Audience": "SchoolERPClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
